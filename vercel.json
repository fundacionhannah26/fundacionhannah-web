{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/subir-video.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/contenido.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=0, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
